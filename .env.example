DATABASE_URL=postgres://stock_social:stock_social@localhost:5432/stock_social
# Any long random string; encrypts SnapTrade user secrets at rest. Changing it orphans stored secrets.
APP_SECRET_KEY=change-me
# Bearer token for POST /api/sync (hourly cron)
CRON_SECRET=change-me
# From the SnapTrade dashboard. Not needed for demo mode.
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# Tests only: points the vendor SDK at the in-repo fake (e2e/fakes/vendor.ts). Never set in production.
SNAPTRADE_BASE_URL=
# Public origin used in sitemap.xml and robots.txt, no trailing slash. Production needs this set, e.g. https://stocksocial.example
NEXT_PUBLIC_SITE_URL=
# Sessions (F-1): signs the session cookie. Falls back to APP_SECRET_KEY when unset.
SESSION_SECRET=
# Per-client sign-in limits need the client's address from a proxy you trust. On Vercel it is read by itself (x-real-ip).
# Elsewhere, set 1 only when every request passes through one proxy that APPENDS the client address to X-Forwarded-For:
# the rightmost entry is used (anything left of it is client-supplied); X-Real-IP is ignored. Unset: per-client limits
# are skipped; the per-address and global limits still apply.
TRUST_PROXY_HEADERS=
# Dev sign-in form at /login/dev (no password). Only honored outside production unless set to 1.
ALLOW_DEV_AUTH=
# Sign-in providers (standard OpenID Connect; a button renders only when its variables are all set).
# Email provider: issuer URL, client id and secret, the button label shown to traders.
AUTH_EMAIL_PROVIDER_ISSUER=
AUTH_EMAIL_PROVIDER_CLIENT_ID=
AUTH_EMAIL_PROVIDER_CLIENT_SECRET=
AUTH_EMAIL_PROVIDER_LABEL=
# Device maker: issuer URL, client (service) id, then either a client secret or team id + key id + private key (PEM, \n-escaped).
AUTH_DEVICE_PROVIDER_ISSUER=
AUTH_DEVICE_PROVIDER_CLIENT_ID=
AUTH_DEVICE_PROVIDER_CLIENT_SECRET=
AUTH_DEVICE_PROVIDER_TEAM_ID=
AUTH_DEVICE_PROVIDER_KEY_ID=
AUTH_DEVICE_PROVIDER_PRIVATE_KEY=
AUTH_DEVICE_PROVIDER_LABEL=
# Optional: user-agent regex for the maker's phones (its button is listed first there).
AUTH_DEVICE_PROVIDER_UA_PATTERN=
# Email-link sending: one HTTPS POST (JSON: from, to, subject, text) with a bearer key. Unset outside production = in-memory, shown on /login/dev.
AUTH_EMAIL_SEND_URL=
AUTH_EMAIL_SEND_KEY=
AUTH_EMAIL_FROM=
# The vendor's connection portal origin, the only page the app frames (CSP frame-src). Default: https://app.snaptrade.com
# and any https subdomain of the vendor's domain; set this to the exact host once confirmed from a live portal URL;
# https only. A portal URL the vendor returns on another origin opens by redirect instead of in the dialog.
VENDOR_PORTAL_ORIGIN=
# The vendor's own security page, linked from the trust notice.
NEXT_PUBLIC_VENDOR_SECURITY_URL=
# F-7 (lib/public-gate.ts): PUBLIC_TRADERS 0 off, 1 on (production: both contacts needed), unset = on outside production,
# loopback only. PUBLIC_SOURCES default insider_reports. FILINGS_CONTACT: User-Agent role contact, e.g. ops@example.com.
PUBLIC_TRADERS=
PUBLIC_SOURCES=
PUBLIC_FILINGS_CONTACT=
PUBLIC_FILINGS_BASE_URL=
PUBLIC_RECORDS_CONTACT=
# Health (GET /api/health): the sync cron's interval in minutes. Unset: the documented 5 (docs/SYNC.md → Cron setup).
# Set 60 if the host only ticks hourly, so health waits a whole round before it reads degraded.
SYNC_CRON_EVERY_MIN=
